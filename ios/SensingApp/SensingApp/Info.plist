<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>edu.uiuc.cs.hcesc.SensingApp.locationupload</string>
		<string>edu.uiuc.cs.hcesc.SensingApp.apprefresh</string>
		<string>edu.uiuc.cs.hcesc.SensingApp.bgProcessing</string>
		<string>edu.uiuc.cs.hcesc.SensingApp.fileUpload</string>
		<string>edu.uiuc.cs.hcesc.SensingApp.sensorkit.fetch</string>
		<string>edu.uiuc.cs.hcesc.SensingApp.healthResearchBgProcessing</string>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSHealthShareUsageDescription</key>
	<string>This app reads your health data to track steps and heart rate.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>This app writes health data to Apple Health.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>
        This app sends reminders to complete your recovery survey.
    </string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>
        App needs location for background tasks.
    </string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>App needs location access while in use.</string>
	<key>NSMotionUsageDescription</key>
	<string>This study collects accelerometer data to analyze recovery patterns.</string>
	<key>NSSensorKitPrivacyPolicyURL</key>
	<string>https://my-site.example.com/privacy-policy/</string>
	<key>NSSensorKitUsageDescription</key>
	<string>This research study collects data from your Apple Watch and iPhone.</string>
    <key>NSSensorKitUsageDetail</key>
    <dict>
        <key>SRSensorUsageMotion</key>
        <dict>
            <key>Description</key>
            <string>Wrist accelerometer data is used to assess movement related metrics to assess recovery of surgery recovery states.</string>
            <key>Required</key>
            <true/>
        </dict>
        <key>SRSensorUsageWristDetection</key>
        <dict>
            <key>Description</key>
            <string>Wrist detection is used to detect when the watch is worn and to use data from those moments to derive movement metrics.</string>
            <key>Required</key>
            <true/>
        </dict>
        <key>SRSensorUsageAmbientPressure</key>
        <dict>
            <key>Description</key>
            <string>Ambient pressure is used to derive altitude and activity context during recovery.</string>
            <key>Required</key>
            <true/>
        </dict>
        <key>SRSensorUsagePhoneUsage</key>
        <dict>
            <key>Description</key>
            <string>Aggregate phone-call activity counts (never call content) are used as an engagement and recovery signal.</string>
            <key>Required</key>
            <true/>
        </dict>
        <key>SRSensorUsageMessageUsage</key>
        <dict>
            <key>Description</key>
            <string>Aggregate messaging activity counts (never message content) are used as an engagement and recovery signal.</string>
            <key>Required</key>
            <true/>
        </dict>
        <key>SRSensorUsageKeyboardMetrics</key>
        <dict>
            <key>Description</key>
            <string>Aggregate keyboard usage metrics (never typed content) are used to assess fine motor recovery.</string>
            <key>Required</key>
            <true/>
        </dict>
        <key>SRSensorUsageAmbientLightSensor</key>
        <dict>
            <key>Description</key>
            <string>Ambient light data is used to characterize the wearer's light exposure patterns as part of assessing recovery of surgery recovery states.</string>
            <key>Required</key>
            <true/>
        </dict>
        <key>SRSensorUsagePPG</key>
        <dict>
            <key>Description</key>
            <string>Photoplethysmogram data is used to derive heart-related metrics to assess recovery of surgery recovery states.</string>
            <key>Required</key>
            <true/>
        </dict>
        <key>SRSensorUsageHeartRate</key>
        <dict>
            <key>Description</key>
            <string>Heartrate is used to assess recovery of surgery recovery states.</string>
            <key>Required</key>
            <true/>
        </dict>
        <key>SRSensorUsageDeviceUsage</key>
        <dict>
            <key>Description</key>
            <string>Device usage data is used to assess phone interaction patterns as part of assessing recovery of surgery recovery states.</string>
            <key>Required</key>
            <true/>
        </dict>
        <key>SRSensorUsageWristTemperature</key>
        <dict>
            <key>Description</key>
            <string>Wrist temperature data is used to monitor physiological changes during sleep as part of assessing recovery of surgery recovery states.</string>
            <key>Required</key>
            <true/>
        </dict>
    </dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>remote-notification</string>
		<string>processing</string>
		<string>fetch</string>
	</array>
	<key>UIFileSharingEnabled</key>
	<true/>
</dict>
</plist>
